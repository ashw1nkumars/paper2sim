# Copy to .env and fill in as needed. Everything has a working default, so the
# app runs with NO changes (it falls back to the offline mock LLM provider).

# LLM: "auto" uses Anthropic if its key is set, else Groq, else Cerebras, else
# the offline mock. Force one with "anthropic", "groq", "cerebras", or "mock".
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# Sandbox limits for generated code (applied in the worker).
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_MEMORY_MB=2048

# Rate limiting on POST /api/papers (per client IP).
RATE_LIMIT_SUBMIT=20
RATE_LIMIT_WINDOW_SECONDS=3600
